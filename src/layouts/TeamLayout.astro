---
/** The layout of /team and /team/past: a title, an intro, rows of author cards and a footer. */
import { site } from "../config/site";
import PageLayout from "./PageLayout.astro";

interface Props {
  title: string;
  description: string;
  /** Show the title and intro (false keeps the title for screen readers only). */
  heading?: boolean;
}

const { title, description, heading = true } = Astro.props;
---

<PageLayout title={`${title} — ${site.name}`} description={description}>
  <div class:list={["team", { headless: !heading }]}>
    <h1 class:list={{ hidden: !heading }}>{title}</h1>
    {heading && Astro.slots.has("intro") && (
      <p class="intro">
        <slot name="intro" />
      </p>
    )}
    <slot />
    <p class="footer">
      <slot name="footer" />
    </p>
  </div>
</PageLayout>

<style>
  .team {
    display: flex;
    flex-direction: column;
    align-items: center;
    max-width: 1000px;
    margin: 0 auto;
    padding: 32px 0 48px;
    font-family: Georgia, sans-serif;
  }
  h1 {
    font-size: 40px;
    font-weight: 800;
    margin: 0 0 24px;
    color: var(--palette-black);
  }
  .headless {
    padding-top: 8px;
  }
  /* Read by screen readers, but not shown */
  .hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
  .intro {
    max-width: 600px;
    margin: 12px 12px 8px;
    text-align: center;
    color: var(--palette-dark-gray);
  }
  .footer {
    margin-top: 24px;
  }
  .footer :global(a) {
    color: var(--palette-dark-blue);
  }
</style>
