---
/**
 * The layout for articles with `layout: false`: the article's body alone is the whole page, with
 * no header, title, byline or footer. For articles that are one full-page visual, which handle
 * their own layout and scrolling, like the old Gatsby site's blank template: the page itself
 * doesn't scroll, and the body fills the window.
 */
import Head from "../components/Head.astro";
import { type Article, articleHead } from "../lib/articles";
import "../styles/global.css";
import "../styles/legacy-typography.css";

interface Props {
  article: Article;
}

const { article } = Astro.props;
---

<!doctype html>
<html lang="en" class="blank-article">
  <head>
    <Head article={articleHead(article)} />
  </head>
  <body>
    <div class="page">
      <slot />
    </div>
  </body>
</html>

<style is:global>
  /* html.blank-article: more specific than src/styles/legacy-typography.css's html rule */
  html.blank-article,
  html.blank-article body {
    overflow: hidden;
    margin: 0;
    padding: 0;
  }
</style>

<style>
  .page {
    width: 100vw;
    height: 100vh;
  }
</style>
