---
/**
 * The layout every page renders into: <head> (see src/components/Head.astro), the fixed
 * header (a link to the team, the logo, and a link to search), and the page content.
 */
import { Image } from "astro:assets";
import wordmark from "../assets/site/dclogoblack.webp";
import Head, { type Props as HeadProps } from "../components/Head.astro";
import "../styles/global.css";

type Props = HeadProps;
---

<!doctype html>
<html lang="en">
  <head>
    <Head {...Astro.props} />
  </head>
  <body>
    {/* Header */}
    <header class="header">
      <a href="/team" class="teamLink">
        Team
      </a>
      <a href="/" class="logoLink" aria-label="The Daily Californian: Data home">
        <Image
          src={wordmark}
          alt="The Daily Californian"
          class="logo"
          height={20}
          densities={[1, 2, 3]}
          loading="eager"
        />
      </a>
      <a href="/search" class="searchLink" aria-label="Search">
        <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
          <circle
            cx="10.5"
            cy="10.5"
            r="6.5"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          ></circle>
          <path
            d="M15.5 15.5 21 21"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
          ></path>
        </svg>
      </a>
    </header>

    {/* Content */}
    <main>
      <slot />
    </main>
  </body>
</html>

<style>
  body {
    padding-top: 50px;
    background-color: var(--palette-light-gray);
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    box-sizing: border-box;
    margin: 0;
  }
  main {
    flex: 1;
    padding: 0 8px;
  }

  /* Header: logo centered */
  .header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 50px;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: white;
    z-index: 9999;
    border-bottom: 1px solid #d3d3d3;
  }
  .logoLink {
    display: flex;
  }
  .logo {
    height: 20px;
    width: auto;
  }
  .searchLink {
    position: absolute;
    right: 16px;
    display: flex;
    padding: 6px;
    color: var(--palette-black);
  }
  .teamLink {
    position: absolute;
    left: 16px;
    padding: 6px;
    font-family: Georgia, sans-serif;
    font-size: 16px;
    color: var(--palette-black);
    text-decoration: none;
  }
  .searchLink:hover,
  .teamLink:hover {
    color: var(--palette-dark-blue);
  }
  /* Leaves room for the team and search links on narrow phones */
  @media (max-width: 440px) {
    .logo {
      height: 16px;
    }
    .searchLink {
      right: 6px;
    }
    .teamLink {
      left: 6px;
      font-size: 14px;
    }
  }
  @media (max-width: 360px) {
    .logo {
      height: 13px;
    }
  }
</style>
