---
/**
 * The layout every page renders into: <head> (with SEO tags built from these props), the fixed
 * header, the page content, and the footer.
 */
import { Image } from "astro:assets";
import logo from "../assets/site/dclogo-black.png";
import Seo, { type Props as SeoProps } from "../components/Seo.astro";
import { site } from "../config/site";
import { withBase } from "../lib/path";
import "../styles/global.css";

type Props = SeoProps;

// Footer navigation
const footerLinks = [
  { href: "/", label: "Home" },
  { href: `mailto:${site.contactEmail}`, label: "Contact" },
  { href: site.githubUrl, label: "GitHub" },
  { href: site.donateUrl, label: "Donate" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href={withBase("/favicon.ico")} />
    <link rel="sitemap" href={withBase("/sitemap-index.xml")} />

    <Seo {...Astro.props} />
  </head>
  <body>
    {/* Header */}
    <header class="header">
      <a href={withBase("/")} class="logoLink" aria-label="The Daily Californian: Data home">
        <Image src={logo} alt="The Daily Californian" class="logo" loading="eager" />
      </a>
    </header>

    {/* Content */}
    <main>
      <slot />
    </main>

    {/* Footer */}
    <footer class="footer">
      <nav class="footerLinks" aria-label="Footer">
        {footerLinks.map((link) => (
          <a href={withBase(link.href)}>{link.label}</a>
        ))}
      </nav>
      <p>
        A project of the Data Department at <a href={site.mainSiteUrl}>The Daily Californian</a>,
        Berkeley's independent, student-run newspaper.
      </p>
    </footer>
  </body>
</html>

<style>
  body {
    padding-top: 50px;
    background-color: var(--palette-light-gray);
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    box-sizing: border-box;
    margin: 0;
  }
  main {
    flex: 1;
    padding: 0 8px;
  }

  /* Header: logo centered */
  .header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 50px;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: white;
    z-index: 9999;
    border-bottom: 1px solid #d3d3d3;
  }
  .logoLink {
    display: flex;
  }
  .logo {
    height: 20px;
    width: auto;
  }
  /* Footer */
  .footer {
    margin-top: 40px;
    padding: 24px 16px 32px;
    border-top: 1px solid #d3d3d3;
    background-color: white;
    text-align: center;
    font-family: var(--font-list);
    font-size: 14px;
    color: var(--palette-dark-gray);
  }
  .footer a {
    color: var(--palette-dark-gray);
  }
  .footerLinks {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 8px 20px;
    margin-bottom: 12px;
  }
  .footer p {
    margin: 0;
  }
</style>
