---
/**
 * The layout every page renders into: <head> (with SEO tags built from these props), the fixed
 * header, and the page content.
 */
import { Image } from "astro:assets";
import wordmark from "../assets/site/dclogoblack.webp";
import Seo, { type Props as SeoProps } from "../components/Seo.astro";
import { withBase } from "../lib/path";
import "../styles/global.css";

type Props = SeoProps;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href={withBase("/favicon.ico")} />
    <link rel="sitemap" href={withBase("/sitemap-index.xml")} />

    <Seo {...Astro.props} />
  </head>
  <body>
    {/* Header */}
    <header class="header">
      <a href={withBase("/")} class="logoLink" aria-label="The Daily Californian: Data home">
        <Image
          src={wordmark}
          alt="The Daily Californian"
          class="logo"
          height={20}
          densities={[1, 2, 3]}
          loading="eager"
        />
      </a>
    </header>

    {/* Content */}
    <main>
      <slot />
    </main>
  </body>
</html>

<style>
  body {
    padding-top: 50px;
    background-color: var(--palette-light-gray);
    display: flex;
    flex-direction: column;
    min-height: 100vh;
    box-sizing: border-box;
    margin: 0;
  }
  main {
    flex: 1;
    padding: 0 8px;
  }

  /* Header: logo centered */
  .header {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 50px;
    box-sizing: border-box;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: white;
    z-index: 9999;
    border-bottom: 1px solid #d3d3d3;
  }
  .logoLink {
    display: flex;
  }
  .logo {
    height: 20px;
    width: auto;
  }
</style>
