---
/** A linked card for an author (picture, name and role), used on /team and /team/past. */
import AuthorPicture from "./AuthorPicture.astro";
import { type Author, EDITOR_ROLE_LABELS, authorPath } from "../lib/authors";

interface Props {
  author: Author;
  /** Load the picture eagerly (for cards visible without scrolling). */
  eager?: boolean;
}

const { author, eager } = Astro.props;
// Editors without an author file are labeled with their role on the team
const role = author.entry?.data.role ?? (author.teamRole && EDITOR_ROLE_LABELS[author.teamRole]);
---

<a href={authorPath(author.slug)} class="authorCard">
  <AuthorPicture author={author} size={120} eager={eager} />
  <span class="name">{author.name}</span>
  {role && <span class="role">{role}</span>}
</a>

<style>
  .authorCard {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    width: 180px;
    margin: 16px 10px;
    font-family: Georgia, sans-serif;
    text-align: center;
    text-decoration: none;
  }
  .authorCard:hover .name {
    text-decoration: underline;
  }
  .name {
    margin-top: 8px;
    font-size: 18px;
    color: var(--palette-black);
  }
  .role {
    font-size: 14px;
    color: var(--palette-dark-gray);
  }
</style>
