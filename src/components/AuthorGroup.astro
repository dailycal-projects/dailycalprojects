---
/** A row of author cards, under an optional heading, used on /team and /team/past. */
interface Props {
  title?: string;
}

const { title } = Astro.props;
---

<section class="authorGroup">
  {title && <h2>{title}</h2>}
  <div class="cards">
    <slot />
  </div>
</section>

<style>
  .authorGroup {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  h2 {
    margin: 24px 0 0;
    padding-top: 12px;
    border-top: 1px solid var(--palette-dark-gray);
    font-size: 15px;
    font-weight: 400;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--palette-dark-gray);
  }
  .cards {
    width: 100%;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
  }
</style>
