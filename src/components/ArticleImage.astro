---
/**
 * An image inside an article: a single image (`src` + `alt`), or a group of images (`images`) laid
 * out side by side in `columns` columns, sharing one caption and attribution. Images are imported
 * from src/assets/images/ (optimize them first; see the README), and resized at build time:
 *
 *   import ArticleImage from "../../../components/ArticleImage.astro";
 *   import protest from "../../../assets/images/2026/my-story/protest.jpg";
 *
 *   <ArticleImage src={protest} alt="Students march on Sproul Plaza" caption="..." attribution="Jane Doe | Staff" />
 */
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface GroupImage {
  src: ImageMetadata;
  alt: string;
}

// The article column's width
const COLUMN_WIDTH = 640;

// Either `src` + `alt`, or `images`
interface Props {
  src?: ImageMetadata;
  alt?: string;
  images?: GroupImage[];
  /** Grid columns for a group of images (1 stacks them). Collapses to 1 on phones. */
  columns?: number;
  caption?: string;
  /** Photo credit, e.g. "Jane Doe | Staff". */
  attribution?: string;
}

const { src, alt, images, columns = 2, caption, attribution } = Astro.props;

if (images ? images.length === 0 : !src) {
  throw new Error("<ArticleImage> needs a src (and alt), or a non-empty images list.");
}
if (!images && alt === undefined) {
  throw new Error(`<ArticleImage> for ${src?.src} needs alt text.`);
}

// Each image's widest displayed width (columns collapse to one on phones, at most the column wide)
const width = Math.round(COLUMN_WIDTH / (images ? columns : 1));
---

<figure class="articleImage">
  {images ? (
    <div class="grid" style={`--columns: ${columns}`}>
      {images.map((image) => (
        <Image src={image.src} alt={image.alt} layout="constrained" width={width} />
      ))}
    </div>
  ) : (
    src && <Image src={src} alt={alt ?? ""} layout="constrained" width={width} />
  )}

  {(caption || attribution) && (
    <figcaption>
      {caption && <em class="caption">{caption}</em>}
      {attribution && <span class="attribution">{attribution}</span>}
    </figcaption>
  )}
</figure>

<style>
  .articleImage {
    margin: 0 0 1.45rem 0;
  }
  .articleImage img {
    width: 100%;
    height: auto;
    display: block;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(var(--columns), 1fr);
    gap: 10px;
  }
  @media (max-width: 640px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
  figcaption {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-top: 10px;
    font-family: var(--font-list);
    color: var(--palette-dark-gray);
  }
  .attribution {
    font-weight: 500;
    font-size: 0.87055rem;
    line-height: 1.1;
  }
</style>
