---
/**
 * An image inside an article: a single image (`src` + `alt`), or a group of images (`images`) laid
 * out side by side in `columns` columns, sharing one caption and attribution. Images are files in
 * public/ by their site path (optimize them first; see the README), or full URLs:
 *
 *   import ArticleImage from "../../components/ArticleImage.astro";
 *
 *   <ArticleImage src="/assets/images/protest.jpg" alt="Students march on Sproul Plaza" caption="..." attribution="Jane Doe | Staff" />
 */
import { withBase } from "../lib/path";

interface GroupImage {
  src: string;
  alt: string;
}

// Either `src` + `alt`, or `images`
interface Props {
  src?: string;
  alt?: string;
  images?: GroupImage[];
  /** Grid columns for a group of images (1 stacks them). Collapses to 1 on phones. */
  columns?: number;
  caption?: string;
  /** Photo credit, e.g. "Jane Doe | Staff". */
  attribution?: string;
}

const { src, alt, images, columns = 2, caption, attribution } = Astro.props;

if (images ? images.length === 0 : !src) {
  throw new Error("<ArticleImage> needs a src (and alt), or a non-empty images list.");
}
if (!images && alt === undefined) {
  throw new Error(`<ArticleImage> for ${src} needs alt text.`);
}
---

<figure class="articleImage">
  {images ? (
    <div class="grid" style={`--columns: ${columns}`}>
      {images.map((image) => (
        <img src={withBase(image.src)} alt={image.alt} loading="lazy" decoding="async" />
      ))}
    </div>
  ) : (
    src && <img src={withBase(src)} alt={alt ?? ""} loading="lazy" decoding="async" />
  )}

  {(caption || attribution) && (
    <figcaption>
      {caption && <em class="caption">{caption}</em>}
      {attribution && <span class="attribution">{attribution}</span>}
    </figcaption>
  )}
</figure>

<style>
  .articleImage {
    margin: 0 0 1.45rem 0;
  }
  .articleImage img {
    width: 100%;
    height: auto;
    display: block;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(var(--columns), 1fr);
    gap: 10px;
  }
  @media (max-width: 640px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
  figcaption {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-top: 10px;
    font-family: var(--font-list);
    color: var(--palette-dark-gray);
  }
  .attribution {
    font-weight: 500;
    font-size: 0.87055rem;
    line-height: 1.1;
  }
</style>
