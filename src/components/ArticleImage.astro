---
/**
 * An image inside an article: a single image (`src` + `alt`), or a group of images (`images`) laid
 * out side by side in `columns` columns, sharing one caption and attribution.
 *
 * In an .mdx article, import the image and pass it in:
 *
 *   import ArticleImage from "../../components/ArticleImage.astro";
 *   import protest from "../../assets/images/2026-03-03-my-story/protest.avif";
 *
 *   <ArticleImage src={protest} alt="Students march on Sproul Plaza" caption="..." attribution="Jane Doe | Staff" />
 */
import type { ImageMetadata } from "astro";
import SmartImage from "./SmartImage.astro";

interface GroupImage {
  src: ImageMetadata | string;
  alt: string;
}

// Either `src` + `alt`, or `images`
interface Props {
  src?: ImageMetadata | string;
  alt?: string;
  images?: GroupImage[];
  /** Grid columns for a group of images (1 stacks them). Collapses to 1 on phones. */
  columns?: number;
  caption?: string;
  /** Photo credit, e.g. "Jane Doe | Staff". */
  attribution?: string;
}

const { src, alt, images, columns = 2, caption, attribution } = Astro.props;

if (images ? images.length === 0 : !src) {
  throw new Error("<ArticleImage> needs a src (and alt), or a non-empty images list.");
}
if (!images && alt === undefined) {
  throw new Error(
    `<ArticleImage> for ${String(typeof src === "string" ? src : src?.src)} needs alt text.`,
  );
}
---

<figure class="articleImage">
  {images ? (
    <div class="grid" style={`--columns: ${columns}`}>
      {images.map((image) => (
        <SmartImage
          src={image.src}
          alt={image.alt}
          sizes={`(max-width: 640px) 100vw, ${Math.ceil(640 / columns)}px`}
        />
      ))}
    </div>
  ) : (
    src && <SmartImage src={src} alt={alt ?? ""} />
  )}

  {(caption || attribution) && (
    <figcaption>
      {caption && <em class="caption">{caption}</em>}
      {attribution && <span class="attribution">{attribution}</span>}
    </figcaption>
  )}
</figure>

<style>
  .articleImage {
    margin: 0 0 1.45rem 0;
  }
  /* :global() since the <img> is rendered by SmartImage, a child component */
  .articleImage :global(img) {
    width: 100%;
    height: auto;
    display: block;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(var(--columns), 1fr);
    gap: 10px;
  }
  @media (max-width: 640px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
  figcaption {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-top: 10px;
    font-family: var(--font-list);
    color: var(--palette-dark-gray);
  }
  .attribution {
    font-weight: 500;
    font-size: 0.87055rem;
    line-height: 1.1;
  }
</style>
