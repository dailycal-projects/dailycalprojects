---
/**
 * Every page's <head>: the charset, viewport and icons, and the SEO tags (title, description,
 * canonical link, robots directive, Open Graph and X card tags, and JSON-LD structured data). An
 * article's page passes articleHead(article); other pages pass their name.
 *
 * This only imports src/lib/articles.ts's types: importing its code would add every article
 * visual's CSS to every page.
 */
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";
import logo from "../assets/site/dclogo-circle.webp";
import { site } from "../config/site";
import type { ArticleHead } from "../lib/articles";

export type Props =
  | {
      article: ArticleHead;
    }
  | {
      article?: undefined;
      /** The page's name, e.g. "Search", shown as "Search — <site name>"; the homepage has none. */
      title?: string;
      description?: string;
      /** Keep the page out of search results (e.g. the 404 page). */
      noindex?: boolean;
    };

const { article } = Astro.props;
const page = article ? {} : Astro.props;

// An article's title has the newspaper's name (Google's structured data guidelines flag that in
// the headline as boilerplate, so the JSON-LD headline doesn't); other pages have the site's
const title = article
  ? `${article.headline} | ${site.articleTitleSuffix}`
  : page.title
    ? `${page.title} — ${site.name}`
    : site.name;
const description = (article ? article.description : page.description) ?? site.description;
const image: ImageMetadata = article?.image ?? logo;
const imageAlt = article?.imageAlt ?? "The Daily Californian logo";
const noindex = page.noindex ?? false;

// astro.config.mjs always sets `site`
const siteURL = Astro.site!;
// Pages are built as <path>.html but served at <path> (see trailingSlash in astro.config.mjs)
const pagePath = Astro.url.pathname.replace(/(^|\/)index\.html$/, "$1").replace(/\.html$/, "");
const canonicalURL = new URL(pagePath, siteURL).href;

// An image for social previews and structured data: at most 1200px wide, and a JPEG (or a PNG, for
// a WebP, which is only used for images with transparency), since not every site that shows link
// previews accepts WebP.
async function resolveImage(src: ImageMetadata) {
  const { src: path, attributes } = await getImage({
    src,
    width: Math.min(src.width, 1200),
    format: src.format === "jpg" || src.format === "jpeg" ? "jpg" : "png",
  });
  return {
    url: new URL(path, siteURL).href,
    width: Number(attributes.width),
    height: Number(attributes.height),
  };
}

const ogImage = await resolveImage(image);
const publisherLogo = await resolveImage(logo);

const publisher = {
  "@type": "Organization",
  name: site.name,
  url: new URL("/", siteURL).href,
  logo: { "@type": "ImageObject", url: publisherLogo.url },
};

const structuredData = article
  ? {
      "@context": "https://schema.org",
      "@type": "NewsArticle",
      headline: article.headline,
      description,
      image: [ogImage.url],
      datePublished: article.date.toISOString(),
      dateModified: article.date.toISOString(),
      author: article.byline.map((name) => ({ "@type": "Person", name })),
      publisher,
      mainEntityOfPage: { "@type": "WebPage", "@id": canonicalURL },
    }
  : {
      "@context": "https://schema.org",
      "@type": "WebSite",
      name: site.name,
      description,
      url: new URL("/", siteURL).href,
      publisher,
    };
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="theme-color" content="#ffffff" />
<meta name="generator" content={Astro.generator} />
<link rel="icon" href="/favicon.ico" />
<link rel="sitemap" href="/sitemap-index.xml" />

<title>{title}</title>
<meta name="description" content={description} />
{article?.keywords && article.keywords.length > 0 && (
  <meta name="keywords" content={article.keywords.join(", ")} />
)}
<link rel="canonical" href={canonicalURL} />
<meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"} />

{/* Open Graph */}
<meta property="og:type" content={article ? "article" : "website"} />
<meta property="og:site_name" content={site.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:locale" content="en_US" />
<meta property="og:image" content={ogImage.url} />
<meta property="og:image:width" content={String(ogImage.width)} />
<meta property="og:image:height" content={String(ogImage.height)} />
<meta property="og:image:alt" content={imageAlt} />
{article && <meta property="article:published_time" content={article.date.toISOString()} />}
{article?.byline.map((name) => (
  <meta property="article:author" content={name} />
))}

{/* X (formerly Twitter) card */}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage.url} />
<meta name="twitter:image:alt" content={imageAlt} />

{/* Structured data ("<" escaped so a value can't close the script tag early) */}
<script
  type="application/ld+json"
  set:html={JSON.stringify(structuredData).replace(/</g, "\\u003c")}
/>
