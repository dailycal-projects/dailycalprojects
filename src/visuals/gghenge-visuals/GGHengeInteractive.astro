---
/**
 * The Golden Gate Henge map: a page of its own (src/pages/interactive/gghenge.astro renders it). Its script is
 * map.js; its styles are global because the map's popups are built from HTML strings at run time.
 */
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Golden Gate Henge</title>

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet" />
</head>

<body>
  <div id="map"></div>

  <div id="helpModal" class="help-modal hidden">
    <div class="help-box">
      <div class="popup-name">How to use this site</div>
      <div class="popup-row">• Use this site to find locations and times to see Golden Gate Henge (GGH) for Fall 2026 and Spring 2027.</div>
      <div class="popup-row">• Drag the slider to change the date.</div>
      <div class="popup-row">• The gold band shows valid areas to view GGH on a given date.</div>
      <div class="popup-row">• Red and blue pins show selected viewing locations on- and off-campus and are listed in the dropdown menu to the right (desktop only).</div>
      <div class="popup-row">• Click any pin to get sunset time, GGH dates and travel options. GGH dates are approximate.</div>
      <div class="popup-row">• Use the search bar to search for pins, addresses, or coordinates, then hit Enter.</div>
      <div class="popup-row">• Click “Today” to go to today’s date.</div>
      <div class="popup-row">• Click on the tags in the top left to filter pins by on- and off-campus or mode of travel. Select multiple tags to match pins in those groups.</div>
      <!--<div class="popup-row">• What do the tags mean? The “walk” tag is for pins that are reachable via foot in under 30 minutes from Sather Gate. The “bike” tag is for pins that are reachable via bike in under 30 minutes. The “transit” tag is for pins that are within a 15 minute walk from a train or bus stop. The “hike” tag is for pins that are reachable via hiking trails. The “drive” tag is for pins that are reachable by car. The “ferry” tag is for pins that must be reached via ferry.</div>-->
      <div class="popup-row">• Click “Filter by Date” to see only valid pins for a given date.</div>
      <div class="popup-row">• Click anywhere on the map to drop a pin and get the sunset time.</div>
      <div class="popup-row">• Click “Reset” to reset the search and map filters.</div>
      <div class="popup-row">• Happy sunset hunting! We do not encourage trespassing or risky behaviors that could result in injury.</div>
      <button id="closeHelp" class="btn help-close">Close</button>
    </div>
  </div>

  <div class="pin-menu-wrap">
    <div class="pin-menu-box">
      <div class="pin-menu-header">
        <div class="pin-menu-title">All Pins</div>
        <div class="pin-menu-controls">
          <select id="pinSortSelect" class="pin-sort-select" aria-label="Sort pins by">
            <option value="alphabet">Sort by: A–Z</option>
            <option value="alphabet-reverse">Sort by: Z–A</option>
            <option value="fall-start">Fall Dates (earliest)</option>
            <option value="fall-end">Fall Dates (latest)</option>
            <option value="spring-start">Spring Dates (earliest)</option>
            <option value="spring-end">Spring Dates (latest)</option>
          </select>
          <button id="pinMenuToggle" class="pin-menu-toggle">Hide</button>
        </div>
      </div>
      <div class="pin-menu-search"><input id="pinNameSearch" type="search" placeholder="Search by pin name" aria-label="Search by pin name" /></div>
      <div id="pinMenuList" class="pin-menu-list" aria-live="polite"></div>
    </div>
  </div>

  <div class="panel">
    <div class="panel-header">
      <span class="panel-title">GGH Locations </span>
      <button type="button" class="panel-subtitle" id="helpText">
        Click here for help using this site
      </button>
    </div>
  
    <div class="search-row">
      <input id="search" type="search" placeholder="Search by pin name, address or coordinates" aria-label="Search by pin name, address or coordinates" enterkeyhint="search" />
      <button class="btn" id="resetBtn">Reset</button>
    </div>
    <div id="searchSuggestions" class="search-suggestions"></div>
  
    <div class="slider-section">
      <div class="slider-header">
        <div class="slider-left">
          <span class="slider-date" id="dateDisplay">
            Oct 1, 2026
          </span>
        </div>
        <div class="slider-right">
          <button class="btn" id="todayBtn">Today</button>
        </div>
      </div>
      <input id="daySlider" type="range" min="274" max="455" step="1" value="274" aria-label="Viewing date" />
    </div>
  
    <div class="legend">
      <div class="legend-group" aria-label="Campus filters">
        <button type="button" id="filterOnCampus" class="legend-item" aria-pressed="false"><span class="legend-dot on-campus" aria-hidden="true"></span>On-Campus</button>
        <button type="button" id="filterOffCampus" class="legend-item" aria-pressed="false"><span class="legend-dot off-campus" aria-hidden="true"></span>Off-Campus</button>
      </div>
      <div class="legend-group travel-filter-group" aria-label="Travel filters">
        <button type="button" id="filterWalk" class="legend-item" aria-pressed="false"><span class="travel-icon" aria-hidden="true">🚶</span>Walk</button>
        <button type="button" id="filterBike" class="legend-item" aria-pressed="false"><span class="travel-icon" aria-hidden="true">🚲</span>Bike</button>
        <button type="button" id="filterTransit" class="legend-item" aria-pressed="false"><span class="travel-icon" aria-hidden="true">🚌</span>Transit</button>
        <button type="button" id="filterHike" class="legend-item" aria-pressed="false"><span class="travel-icon" aria-hidden="true">⛰️</span>Hike</button>
        <button type="button" id="filterDrive" class="legend-item" aria-pressed="false"><span class="travel-icon" aria-hidden="true">🚗</span>Drive</button>
        <button type="button" id="filterFerry" class="legend-item" aria-pressed="false"><span class="travel-icon" aria-hidden="true">⛴️</span>Ferry</button>
      </div>
    </div>
  
    <div class="bottom-row">
      <div class="count-line" id="countLine"></div>
      <button class="btn" id="showAllBtn">Filter by Date</button>
    </div>
  </div>

  <script>
    import "./map.js";
  </script>
</body>
</html>

<style is:global>
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }
  
    html, body {
      height: 100%;
      margin: 0;
      font-family: "DM Sans", sans-serif;
      background: #ece8e1;
      color: #1f2328;
    }
  
    #map {
      position: absolute;
      inset: 0;
    }
  
    .panel {
      position: absolute;
      top: 18px;
      left: 18px;
      z-index: 1000;
      background: rgba(250, 248, 244, 0.86);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      padding: 18px 16px 14px;
      border: 1px solid rgba(70, 60, 54, 0.12);
      border-radius: 14px;
      box-shadow: 0 8px 24px rgba(40, 30, 20, 0.12);
      width: 360px;
    }
  
    .panel-header {
      display: flex;
      align-items: baseline;
      gap: 20px;
      margin-bottom: 14px;
      border-bottom: 1px solid rgba(70, 60, 54, 0.08);
      padding-bottom: 12px;
    }
  
    .panel-title {
      font-family: "DM Mono", monospace;
      font-size: 15px;
      font-weight: 500;
      letter-spacing: 0.04em;
      color: #1f2328;
    }
  
    .panel-subtitle {
      font-size: 11px;
      color: rgba(31, 35, 40, 0.52);
      font-weight: 400;
    }
  
    #helpText {
      border: 0;
      background: transparent;
      font-family: inherit;
      text-align: left;
      cursor: pointer;
      text-decoration: underline;
    }
  
    #helpText:hover {
      text-decoration: none;
    }
  
    .search-row {
      display: flex;
      gap: 6px;
      margin-bottom: 14px;
    }
  
    .search-suggestions {
      position: relative;
      margin-top: -8px;
      margin-bottom: 12px;
      z-index: 1100;
    }
  
    .search-suggestions-box {
      background: rgba(250, 248, 244, 0.97);
      border: 1px solid rgba(70, 60, 54, 0.10);
      border-radius: 10px;
      box-shadow: 0 10px 24px rgba(40, 30, 20, 0.12);
      overflow: hidden;
    }
  
    .search-suggestion-item {
      padding: 9px 11px;
      cursor: pointer;
      border-bottom: 1px solid rgba(70, 60, 54, 0.06);
      background: transparent;
    }
  
    .search-suggestion-item:last-child {
      border-bottom: none;
    }
  
    .search-suggestion-item:hover {
      background: rgba(255,255,255,0.82);
    }
  
    .search-suggestion-main {
      font-size: 11px;
      font-weight: 500;
      color: #1f2328;
      line-height: 1.3;
    }
  
    .search-suggestion-sub {
      font-size: 10px;
      color: rgba(31, 35, 40, 0.55);
      margin-top: 2px;
      line-height: 1.3;
    }
  
    input[type="search"] {
      flex: 1;
      padding: 9px 11px;
      border-radius: 9px;
      border: 1px solid rgba(70, 60, 54, 0.10);
      background: rgba(255,255,255,0.72);
      color: #1f2328;
      font-family: "DM Sans", sans-serif;
      font-size: 10px;
      outline: none;
      transition: border-color 0.15s, background 0.15s;
    }
  
    input[type="search"]::placeholder {
      color: rgba(31, 35, 40, 0.38);
      font-size: 10px;
    }
  
    input[type="search"]:focus {
      border-color: rgba(111, 143, 184, 0.65);
      background: rgba(255,255,255,0.92);
    }
  
    input[type="search"]::-webkit-search-cancel-button {
      display: none;
    }
  
    .btn {
      border: 1px solid rgba(70, 60, 54, 0.10);
      border-radius: 9px;
      padding: 8px 11px;
      cursor: pointer;
      font-family: "DM Mono", monospace;
      font-size: 11px;
      background: rgba(255,255,255,0.7);
      color: rgba(31, 35, 40, 0.72);
      transition: background 0.15s, color 0.15s, border-color 0.15s;
      white-space: nowrap;
    }
  
    .btn:hover {
      background: rgba(255,255,255,0.95);
      color: #1f2328;
      border-color: rgba(70, 60, 54, 0.18);
    }
  
    .slider-section {
      margin-bottom: 14px;
    }
  
    .slider-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 8px;
    }
  
    .slider-left {
      display: flex;
      align-items: baseline;
      gap: 10px;
    }
  
    .slider-right {
      display: flex;
      align-items: center;
      gap: 8px;
    }
  
    .slider-divider {
      color: rgba(255,255,255,0.35);
    }
  
    .slider-label {
      font-family: "DM Mono", monospace;
      font-size: 12px;
      color: rgba(31, 35, 40, 0.58);
    }
  
    .slider-date {
      font-family: "DM Mono", monospace;
      font-size: 13px;
      font-weight: 500;
      color: #1f2328;
      letter-spacing: 0.03em;
    }
  
    input[type="range"] {
      width: 100%;
      height: 3px;
      -webkit-appearance: none;
      appearance: none;
      background: rgba(70, 60, 54, 0.16);
      border-radius: 999px;
      outline: none;
      cursor: pointer;
    }
  
    input[type="range"]::-webkit-slider-thumb {
      -webkit-appearance: none;
      width: 15px;
      height: 15px;
      border-radius: 50%;
      background: #f7f4ee;
      border: 1.5px solid rgba(70, 60, 54, 0.55);
      box-shadow: 0 1px 4px rgba(0,0,0,0.12);
      cursor: pointer;
    }
  
    input[type="range"]::-moz-range-thumb {
      width: 15px;
      height: 15px;
      border-radius: 50%;
      background: #f7f4ee;
      border: 1.5px solid rgba(70, 60, 54, 0.55);
      cursor: pointer;
    }
  
    .legend {
      display: block;
      margin-bottom: 12px;
      padding: 10px 10px;
      background: rgba(255,255,255,0.5);
      border-radius: 9px;
      border: 1px solid rgba(70, 60, 54, 0.08);
    }
  
    .legend-item {
      display: flex;
      align-items: center;
      gap: 7px;
      font-size: 11px;
      color: rgba(31, 35, 40, 0.68);
    }

    .legend-group { display: flex; flex-wrap: wrap; gap: 6px; }
    .legend-group + .legend-group { margin-top: 16px; }
    .travel-filter-group { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); }
    button.legend-item {
      -webkit-appearance: none;
      appearance: none;
      min-width: 0;
      line-height: 1.2;
      padding: 6px 8px;
      border: 1px solid rgba(70, 60, 54, 0.16);
      border-radius: 16px;
      background: rgba(255,255,255,0.6);
      font-family: inherit;
      cursor: pointer;
    }
    button.legend-item:hover { background: #fff; }
    button.legend-item[aria-pressed="true"] {
      background: #dfe7ef;
      border-color: #6f8fb8;
      color: #263c57;
    }
    button.legend-item:focus-visible { outline: 2px solid #476a95; outline-offset: 2px; }
    .travel-icon { font-size: 16px; line-height: 1.2; }
    .travel-modes { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 6px; }
    .popup-travel-tag { padding: 3px 8px; border: 1px solid rgba(70,60,54,0.16); border-radius: 20px; background: rgba(70,60,54,0.05); }
    .pin-menu-search { display: flex; padding: 10px 14px; border-bottom: 1px solid rgba(70,60,54,0.08); }
    .pin-menu-search input { width: 100%; min-width: 0; }
    .pin-menu-empty { padding: 18px 14px; font-size: 12px; color: #67635e; }
  
    .legend-dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      flex-shrink: 0;
      border: 1px solid rgba(255,255,255,0.75);
    }
  
    .legend-dot.on-campus {
      background: #6f8fb8;
    }
  
    .legend-dot.off-campus {
      background: #b87a6f;
    }
  
    .bottom-row {
      display: flex;
      align-items: center;
      margin-top: 10px;
    }
  
    .bottom-row .btn {
      margin-left: auto;
    }
  
    .count-line {
      font-family: "DM Mono", monospace;
      font-size: 10px;
      color: rgba(31, 35, 40, 0.45);
      letter-spacing: 0.03em;
    }
  
    .maplibregl-popup-content {
      background: rgba(250, 248, 244, 0.97) !important;
      border: 1px solid rgba(70, 60, 54, 0.10) !important;
      border-radius: 12px !important;
      padding: 0 !important;
      box-shadow: 0 12px 28px rgba(40, 30, 20, 0.16) !important;
      font-family: "DM Sans", sans-serif !important;
      color: #1f2328 !important;
      min-width: 280px;
      max-width: 300px;
      overflow: hidden;
    }
  
    .maplibregl-popup-tip {
      display: none !important;
    }
  
    .maplibregl-popup-close-button {
      color: rgba(31, 35, 40, 0.45) !important;
      font-size: 16px !important;
      padding: 4px 8px !important;
    }
  
    .maplibregl-popup-close-button:hover {
      color: #1f2328 !important;
    }

    .maplibregl-popup { z-index: 1001; }
    #map.popups-behind-controls .maplibregl-popup { z-index: 999; }
  
    .popup-photo {
      width: 100%;
      height: 140px;
      object-fit: cover;
      display: block;
      border-bottom: 1px solid rgba(70, 60, 54, 0.08);
    }
  
    .popup-body {
      padding: 13px 15px 14px;
    }
  
    .popup-name {
      font-weight: 600;
      font-size: 13px;
      margin-bottom: 8px;
      line-height: 1.3;
      padding-right: 24px;
    }
  
    .popup-row {
      font-size: 11px;
      color: rgba(31, 35, 40, 0.62);
      margin-bottom: 4px;
      line-height: 1.4;
    }
  
    .popup-row strong {
      color: rgba(31, 35, 40, 0.82);
      font-weight: 600;
    }
  

    .popup-notes {
      margin-top: 12px; 
    }
  
  
  

    .popup-tag {
      display: inline-block;
      margin-top: 8px;
      padding: 2px 8px;
      border-radius: 20px;
      font-size: 10px;
      font-family: "DM Mono", monospace;
      letter-spacing: 0.04em;
    }
  
    .popup-tag.on-campus {
      background: rgba(111,143,184,0.12);
      color: #5f7fa8;
      border: 1px solid rgba(111,143,184,0.22);
    }
  
    .popup-tag.off-campus {
      background: rgba(184,122,111,0.12);
      color: #a76c61;
      border: 1px solid rgba(184,122,111,0.22);
    }
  
    .maplibregl-ctrl-attrib {
      font-size: 10px !important;
      color: rgba(31, 35, 40, 0.5) !important;
    }

    .help-modal {
      position: fixed;
      inset: 0;
      background: rgba(0,0,0,0.25);
      display: flex;
      align-items: center;
      justify-content: center;
      z-index: 2000;
    }

    .help-modal.hidden {
      display: none;
    }

    .help-box {
      background: rgba(250, 248, 244, 0.97);
      border: 1px solid rgba(70, 60, 54, 0.10);
      border-radius: 14px;
      padding: 18px 20px;
      width: 300px;
      box-shadow: 0 12px 28px rgba(40, 30, 20, 0.18);
    }

    .help-title {
      font-weight: 600;
      font-size: 14px;
      margin-bottom: 10px;
    }

    .help-row {
      font-size: 11px;
      margin-bottom: 6px;
      color: rgba(31,35,40,0.7);
    }

    .help-close {
      margin-top: 12px;
      width: 100%;
    }

    .pin-menu-wrap {
      position: absolute;
      top: 18px;
      right: 18px;
      z-index: 1000;
      width: 340px;
    }

    .pin-menu-box {
      background: rgba(250, 248, 244, 0.86);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      border: 1px solid rgba(70, 60, 54, 0.12);
      border-radius: 14px;
      box-shadow: 0 8px 24px rgba(40, 30, 20, 0.12);
      overflow: hidden;
    }

    .pin-menu-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 10px;
      padding: 12px 14px;
      border-bottom: 1px solid rgba(70, 60, 54, 0.08);
    }

    .pin-menu-title {
      font-family: "DM Mono", monospace;
      font-size: 12px;
      color: #1f2328;
      letter-spacing: 0.03em;
    }

    .pin-menu-controls {
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .pin-sort-select {
      border: 1px solid rgba(70, 60, 54, 0.10);
      border-radius: 9px;
      padding: 7px 9px;
      background: rgba(255,255,255,0.72);
      color: #1f2328;
      font-family: "DM Sans", sans-serif;
      font-size: 11px;
      outline: none;
    }

    .pin-menu-toggle {
      border: 1px solid rgba(70, 60, 54, 0.10);
      border-radius: 9px;
      padding: 7px 10px;
      cursor: pointer;
      font-family: "DM Mono", monospace;
      font-size: 11px;
      background: rgba(255,255,255,0.7);
      color: rgba(31, 35, 40, 0.72);
      transition: background 0.15s, color 0.15s, border-color 0.15s;
      white-space: nowrap;
    }

    .pin-menu-toggle:hover {
      background: rgba(255,255,255,0.95);
      color: #1f2328;
      border-color: rgba(70, 60, 54, 0.18);
    }

    .pin-menu-list {
      max-height: 425px;
      overflow-y: auto;
    }

    .pin-menu-list.hidden {
      display: none;
    }

    .pin-menu-item {
      width: 100%;
      border: none;
      border-bottom: 1px solid rgba(70, 60, 54, 0.06);
      background: transparent;
      text-align: left;
      padding: 11px 14px;
      cursor: pointer;
      font-family: "DM Sans", sans-serif;
      transition: background 0.15s;
    }

    .pin-menu-item:last-child {
      border-bottom: none;
    }

    .pin-menu-item:hover {
      background: rgba(255,255,255,0.78);
    }

    .pin-menu-item-name {
      font-size: 12px;
      font-weight: 700;
      color: #1f2328;
      line-height: 1.35;
      margin-bottom: 4px;
    }

    .pin-menu-item-meta {
      font-size: 10px;
      color: rgba(31, 35, 40, 0.62);
      line-height: 1.45;
    }

    @media (max-width: 900px), (max-height: 500px) and (max-width: 1100px) {
      #map {
        position: fixed;
        inset: 0;
        height: 100dvh;
      }

      .panel {
        top: 10px;
        left: 10px;
        right: 10px;
        width: auto;
        padding: 10px 10px 8px;
        border-radius: 12px;
        max-height: 40vh;
        max-height: 40dvh;
        overflow-y: auto;
        overscroll-behavior: contain;
      }

      .panel-header {
        gap: 8px;
        flex-wrap: wrap;
        margin-bottom: 6px;
        padding-bottom: 6px;
      }

      .panel-title {
        font-size: 13px;
      }

      .search-row {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 6px;
        margin-bottom: 8px;
      }

      input[type="search"] {
        font-size: 16px;
        min-width: 0;
      }

      input[type="search"]::placeholder { font-size: 12px; }

      .btn {
        font-size: 10px;
        padding: 7px 9px;
        min-height: 44px;
      }

      .slider-section {
        margin-bottom: 8px;
      }

      .slider-header {
        display: grid;
        grid-template-columns: 1fr auto;
        gap: 6px;
        margin-bottom: 6px;
      }

      .slider-label {
        font-size: 11px;
      }

      .slider-date {
        font-size: 12px;
      }

      input[type="range"] {
        height: 28px;
        background: linear-gradient(rgba(70, 60, 54, 0.16), rgba(70, 60, 54, 0.16)) center / 100% 3px no-repeat;
      }

      input[type="range"]::-webkit-slider-thumb { width: 24px; height: 24px; }
      input[type="range"]::-moz-range-thumb { width: 24px; height: 24px; }
      button.legend-item { height: 44px; min-height: 44px; max-height: 44px; }
      .travel-filter-group {
        grid-template-rows: repeat(2, 44px);
        align-content: start;
      }
