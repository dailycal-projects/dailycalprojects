---
/**
 * Image optimization pipeline, for editors.
 * Converts an image to a web-optimized JPEG entirely in the browser (nothing
 * is uploaded) and offers it as a download. The settings are shared with
 * `npm run optimize`, in src/lib/image-optimization.mjs.
 *
 * See README.md's "Optimizing images" section for what this does and why.
 */
---

<html lang="en">
  {/* Head metadata */}
  <head>
    <meta charset="utf-8" />
    {/* Tell robots no index */}
    <meta name="robots" content="noindex" />
    <title>Image optimization</title>
  </head>
  <body>
    {/* File input and output */}
    <input type="file" id="file" />
    <pre id="out"></pre>

    {/* Rendered result */}
    <div id="result" hidden>
      <a id="download">Download optimized image</a>
      <br />
      Show:{" "}
      <label>
        <input type="radio" name="view" id="show-original" /> Original
      </label>{" "}
      <label>
        <input type="radio" name="view" id="show-optimized" /> Optimized
      </label>
      <br />
      <img id="original" alt="Original" style="max-width:100%" />
      <img id="optimized" alt="Optimized" style="max-width:100%" />
    </div>

    {/* Optimization script */}
    <script>
      import encode from "@jsquash/jpeg/encode.js";
      import initResize, { resize } from "@jsquash/resize/lib/resize/pkg/squoosh_resize.js";
      import {
        JPEG_QUALITY,
        MAX_DIMENSION,
        checkExtension,
        formatBytes,
        formatChange,
      } from "../../lib/image-optimization.mjs";

      // JPEG has no transparency, so transparent pixels are flattened onto the
      // site's white page background.
      const FLATTEN_BACKGROUND = "#ffffff";

      // Index of lanczos3 in the resizer's method list (the same kernel sharp uses)
      const LANCZOS3 = 3;

      const $ = (id: string) => document.getElementById(id)!;
      const input = $("file") as HTMLInputElement;
      const out = $("out");
      const result = $("result");
      const originalImg = $("original") as HTMLImageElement;
      const optimizedImg = $("optimized") as HTMLImageElement;
      const showOriginal = $("show-original") as HTMLInputElement;
      const showOptimized = $("show-optimized") as HTMLInputElement;
      const download = $("download") as HTMLAnchorElement;

      // Optimize a single image file
      async function optimize(file: File, originalUrl: string) {
        const dot = file.name.lastIndexOf(".");
        const ext = dot > 0 ? file.name.slice(dot).toLowerCase() : "";
        const base = dot > 0 ? file.name.slice(0, dot) : file.name;

        checkExtension(ext);

        // Decoding through an <img> applies the EXIF orientation, like sharp's
        // .rotate(), and drawing it converts any color profile to sRGB.
        const img = new Image();
        img.src = originalUrl;
        try {
          await img.decode();
        } catch {
          throw new Error(
            `This browser can't decode this ${ext} file (HEIC and TIFF only open in Safari). ` +
              `Export it to a JPEG or PNG first, then run this again on that file.`,
          );
        }
        const width = img.naturalWidth;
        const height = img.naturalHeight;

        // Flatten onto the background
        const canvas = document.createElement("canvas");
        canvas.width = width;
        canvas.height = height;
        const ctx = canvas.getContext("2d")!;
        ctx.fillStyle = FLATTEN_BACKGROUND;
        ctx.fillRect(0, 0, width, height);
        ctx.drawImage(img, 0, 0);
        let pixels = ctx.getImageData(0, 0, width, height).data;

        // Fit inside MAX_DIMENSION x MAX_DIMENSION without enlarging, rounding
        // the same way sharp does
        const scale = Math.min(1, MAX_DIMENSION / Math.max(width, height));
        const newWidth = Math.max(1, Math.round(width * scale));
        const newHeight = Math.max(1, Math.round(height * scale));
        if (newWidth !== width || newHeight !== height) {
          await initResize();
          // Resize in sRGB rather than linear light, as sharp does. The result is
          // a fresh copy out of wasm memory, so it's backed by a plain
          // ArrayBuffer; the resizer's types just predate typed array generics.
          pixels = resize(
            new Uint8Array(pixels.buffer),
            width,
            height,
            newWidth,
            newHeight,
            LANCZOS3,
            true,
            false,
          ) as Uint8ClampedArray<ArrayBuffer>;
        }

        // mozjpeg's own defaults (progressive, trellis quantisation, overshoot
        // deringing, optimised scans, quantisation table 3) are what sharp's
        // `mozjpeg: true` turns on, so only quality and subsampling are set.
        // chroma_subsample: 1 samples chroma at full resolution (4:4:4).
        const jpeg = await encode(new ImageData(pixels, newWidth, newHeight), {
          quality: JPEG_QUALITY,
          auto_subsample: false,
          chroma_subsample: 1,
        });

        return {
          blob: new Blob([jpeg], { type: "image/jpeg" }),
          outputName: `${base}.jpg`,
          width,
          height,
          newWidth,
          newHeight,
        };
      }

      function show(optimized: boolean) {
        originalImg.hidden = optimized;
        optimizedImg.hidden = !optimized;
        showOriginal.checked = !optimized;
        showOptimized.checked = optimized;
      }
      showOriginal.onchange = () => show(false);
      showOptimized.onchange = () => show(true);

      let run = 0;
      input.onchange = async () => {
        const thisRun = ++run;
        const file = input.files?.[0];
        result.hidden = true;
        URL.revokeObjectURL(originalImg.src);
        URL.revokeObjectURL(optimizedImg.src);
        if (!file) {
          out.textContent = "";
          return;
        }

        out.textContent = `Optimizing ${file.name}…`;
        const originalUrl = URL.createObjectURL(file);
        try {
          const r = await optimize(file, originalUrl);
          // A newer file was chosen while this one was processing
          if (thisRun !== run) {
            URL.revokeObjectURL(originalUrl);
            return;
          }

          const optimizedUrl = URL.createObjectURL(r.blob);
          originalImg.src = originalUrl;
          optimizedImg.src = optimizedUrl;
          download.href = optimizedUrl;
          download.download = r.outputName;
          out.textContent =
            `${file.name} -> ${r.outputName}\n` +
            `original:  ${r.width}x${r.height}, ${formatBytes(file.size)}\n` +
            `optimized: ${r.newWidth}x${r.newHeight}, ${formatBytes(r.blob.size)}\n` +
            `change:    ${formatChange(r.width * r.height, r.newWidth * r.newHeight)} pixels, ` +
            `${formatChange(file.size, r.blob.size)} file size`;
          show(true);
          result.hidden = false;
        } catch (err) {
          URL.revokeObjectURL(originalUrl);
          if (thisRun === run) out.textContent = `${file.name}: FAILED — ${(err as Error).message}`;
        }
      };
    </script>
  </body>
</html>
