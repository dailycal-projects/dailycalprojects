---
/** /team: the Data Team now, from src/config/team.json: the editors, then everyone else. */
import AuthorCard from "../../components/AuthorCard.astro";
import AuthorGroup from "../../components/AuthorGroup.astro";
import TeamLayout from "../../layouts/TeamLayout.astro";
import { currentTeam, getAuthors } from "../../lib/authors";

const team = currentTeam(await getAuthors());
const editors = team.filter((author) => author.teamRole !== "reporter");
const staff = team.filter((author) => author.teamRole === "reporter");
---

<TeamLayout title="Team" description="The Daily Californian's Data Team." heading={false}>
  <AuthorGroup title="Editors">
    {editors.map((author) => (
      <AuthorCard author={author} eager />
    ))}
  </AuthorGroup>
  <AuthorGroup title="Staff">
    {staff.map((author) => (
      <AuthorCard author={author} />
    ))}
  </AuthorGroup>
  <Fragment slot="footer">
    <a href="/team/past">Past contributors</a>
  </Fragment>
</TeamLayout>
