---
/**
 * /team/past: everyone with an author file or a byline who isn't on the team now, grouped by the
 * year of their latest article.
 */
import AuthorCard from "../../components/AuthorCard.astro";
import AuthorGroup from "../../components/AuthorGroup.astro";
import TeamLayout from "../../layouts/TeamLayout.astro";
import { getAuthors, pastTeam } from "../../lib/authors";

const groups = pastTeam(await getAuthors());
---

<TeamLayout
  title="Past Contributors"
  description="The Daily Californian Data Team's past members and contributors."
>
  {groups.map(({ year, authors }, g) => (
    <AuthorGroup title={year ? String(year) : "No articles"}>
      {authors.map((author, i) => (
        <AuthorCard author={author} eager={g === 0 && i < 5} />
      ))}
    </AuthorGroup>
  ))}
  <Fragment slot="footer">
    <a href="/team">The team now</a>
  </Fragment>
</TeamLayout>
